@page "/"
@inject CompanyDataService CompanyDataService

<PageTitle>Companydle</PageTitle>

<section class="text-shell">
    <p class="text-success-emphasis mb-1">$ ./guess --daily</p>
    <h1 class="display-5 fw-bold glow">Companydle<span class="terminal-cursor" aria-hidden="true"></span></h1>
    <p class="lead mb-2">Guess the hidden company in eight tries.</p>
    <p class="text-body-secondary">
        One company a day. Ten stats per guess. The same puzzle for everyone.
    </p>

    <HowToPlay />

    @if (_loading)
    {
        <div class="alert alert-secondary mt-4 mb-0" role="status">
            Loading company data...
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger mt-4 mb-0" role="alert">
            <p class="mb-2"><span class="fw-semibold">Could not load company data.</span> @_error</p>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Retry</button>
        </div>
    }
    else if (_data is not null)
    {
        <div class="alert alert-secondary mt-4 mb-0" role="status">
            <span class="fw-semibold text-success-emphasis">Seed data loaded.</span>
            @_data.Companies.Count companies, @CandidateCount answer candidates.
            Snapshot @_data.DataAsOf.ToString("yyyy-MM-dd").
        </div>
    }
</section>

@code {
    private CompanyData? _data;
    private string? _error;
    private bool _loading = true;

    private int CandidateCount => _data?.Companies.Count(company => company.IsAnswerCandidate) ?? 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _data = await CompanyDataService.LoadAsync(forceReload: true);
        }
        catch (Exception exception)
        {
            _data = null;
            _error = exception.Message;
            Console.Error.WriteLine(exception);
        }
        finally
        {
            _loading = false;
        }
    }
}
